# Database — Turso in the cloud, or a local file for development:
#   TURSO_DATABASE_URL=file:./local.db
# For a local file, TURSO_AUTH_TOKEN is unused but must still be non-empty:
# drizzle-kit's `turso` dialect refuses to run without one.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Enrichment and LLM extraction fallback
ANTHROPIC_API_KEY=sk-ant-...

# Image and archived-source storage
BLOB_READ_WRITE_TOKEN=

# NextAuth session signing — generate with: openssl rand -base64 32
AUTH_SECRET=

# One-time migration only. Create an internal integration at
# https://www.notion.so/my-integrations, then share the "Library" database
# with it (Share -> the integration name). Safe to delete once migrated.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=a4ac088b-6fea-4de2-bde5-594f328bce9d

# Sentry (https://willowbrook.sentry.io/projects/sifted/).
#
# The DSN is not a secret and is compiled into the app as a fallback in
# src/instrumentation-client.ts and src/sentry.*.config.ts, so error reporting
# works without setting anything here. These two only exist to point a
# checkout or a deployment at a different Sentry project.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
#
# This one *is* a secret, and it is build-time only: it authorizes uploading
# source maps, which is what makes a production stack trace show this source
# instead of minified bundle output. Without it `next build` still succeeds and
# silently skips the upload. Create it at
# https://willowbrook.sentry.io/settings/auth-tokens/ with project:releases
# scope, and set it in the Vercel project's environment variables.
SENTRY_AUTH_TOKEN=
