{
  "name": "sifted",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "tsx scripts/extract-url.ts",
    "import": "tsx --env-file-if-exists=.env.local scripts/import-url.ts",
    "images": "tsx --env-file-if-exists=.env.local scripts/repair-images.ts",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-users.ts",
    "token": "tsx --env-file-if-exists=.env.local scripts/issue-token.ts",
    "unenriched": "tsx --env-file-if-exists=.env.local scripts/list-unenriched.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-notion.ts",
    "migrate:verify": "tsx --env-file-if-exists=.env.local scripts/migration-verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@libsql/client": "^0.17.4",
    "@mozilla/readability": "^0.6.0",
    "@notionhq/client": "^5.26.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
